(function(Drupal,drupalSettings){"use strict";drupalSettings.antibot=drupalSettings.antibot||{};Drupal.antibot={};Drupal.behaviors.antibot={attach:function(context,settings){drupalSettings=settings;drupalSettings.antibot.human=false;document.body.addEventListener('mousemove',function(){Drupal.antibot.unlockForms();});document.body.addEventListener('touchmove',function(){Drupal.antibot.unlockForms();});document.body.addEventListener('keydown',function(e){if((e.code=='Tab')||(e.code=='Enter'))Drupal.antibot.unlockForms();});}};Drupal.antibot.unlockForms=function(){if(!drupalSettings.antibot.human){if(drupalSettings.antibot.forms!=undefined)Object.values(drupalSettings.antibot.forms).forEach(function(config){const form=document.getElementById(config.id);if(form){form.setAttribute('action',form.getAttribute('data-action'));const input=form.querySelector('input[name="antibot_key"]');if(input)input.value=config.key.split("").reverse().join("").match(/.{1,2}/g).map((value)=>value.split("").reverse().join("")).join("");}});drupalSettings.antibot.human=true;}};})(Drupal,drupalSettings);;
document.addEventListener("DOMContentLoaded",function(){var chatBlock=document.getElementById("block-cumminsestlivechatbuttonblock");if(chatBlock)document.body.classList.add("page-with-chatbot");});;
const current_path=window.location.pathname;let current_lang_code=current_path.split("/")[1];const language_codes=["en","rs","es","cz","jp","kr","de","it","pl","ro","tr","fr","pt","sr"];const language_codes_to_regions={"cz":"CZ","de":"DE","es":"US","fr":"FR","it":"IT","pl":"PL","ro":"RO","tr":"TR","rs":"RS","jp":"JP","kr":"KR","pt":"BR","en":"US","sr":"RS"};const referrer_url=document.referrer;if(referrer_url!=""&&referrer_url.search('locset')==-1){localStorage.setItem("referrer_url",referrer_url);let refer_lang_code=referrer_url.split("/")[3];if(!language_codes.includes(refer_lang_code))refer_lang_code='en';localStorage.setItem("referrer_lang_code",refer_lang_code);if(language_codes_to_regions[refer_lang_code]){var now=new Date();var time=now.getTime();var expireTime=time+100000*36000;now.setTime(expireTime);}}const urlParams=new URLSearchParams(window.location.search);if(!language_codes.includes(current_lang_code))current_lang_code='en';localStorage.setItem("current_lang_code",current_lang_code);const ref_lang_code=localStorage.getItem("referrer_lang_code");if(ref_lang_code!=""&&ref_lang_code!=current_lang_code){const ref_url=localStorage.getItem("referrer_url");if(ref_url!==undefined&&ref_url!==null&&ref_url.length>0){let referrer_url_array=ref_url.split("/");referrer_url_array[3]=current_lang_code;const new_referer_url=new URL(localStorage.getItem("referrer_url"));let new_path=new_referer_url.pathname;if(ref_lang_code!="en"){const new_path_array=new_path.split("/");new_path=new_path_array.splice(0,2).join("/");}let redirect_url;if(current_lang_code!=='en')redirect_url=`${location.protocol}//${location.host}/${current_lang_code}${current_path}`;else redirect_url=`${location.protocol}//${location.host}${current_path}`;if(urlParams.toString()){urlParams.delete('locset');if(urlParams.toString())redirect_url+=`?${urlParams.toString()}`;}window.location=redirect_url;}};
var cookieValue=checkCookie('cummins_region');function checkCookie(cookiename){var myCookie=getCookie(cookiename);if(myCookie===null)jQuery(document).ready(function(){jQuery('.button--red-x-close').on('click',function(){var now=new Date();var time=now.getTime();var expireTime=time+100000*36000;now.setTime(expireTime);var tempExp='Wed, 31 Oct 2012 08:50:17 GMT';document.cookie='cummins_region=Corporate;secure;expires='+now.toGMTString()+';path=/';document.cookie='acquia_a=Corporate;secure;expires='+now.toGMTString()+';path=/';document.cookie="acquia_a=Corporate";jQuery('#block-countryregion-menu').text('Corporate');});});else jQuery(document).ready(function(){if(myCookie=="Latin%2BAmerica")jQuery('#block-countryregion-menu').text("Centroamerica");else jQuery('#block-countryregion-menu').text(myCookie.replace(/%2B/g," "));});}function getCookie(name){var dc=document.cookie;var prefix=name+"=";var begin=dc.indexOf("; "+prefix);if(begin==-1){begin=dc.indexOf(prefix);if(begin!==0)return null;}else{begin+=2;var end=document.cookie.indexOf(";",begin);if(end==-1)end=dc.length;}return decodeURI(dc.substring(begin+prefix.length,end));};
