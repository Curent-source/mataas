function cumminsSanitizeLog(log){const logMessage=String(log);return logMessage.replace(/[&<>"']/g,function(char){switch(char){case '&':return '&amp;';case '<':return '&lt;';case '>':return '&gt;';case '"':return '&quot;';case "'":return '&#039;';default:return char;}});}function cumminsSanitizeHtml(unsafeHtml){if(unsafeHtml instanceof HTMLElement){const scripts=unsafeHtml.getElementsByTagName('script');while(scripts.length>0)scripts[0].parentNode.removeChild(scripts[0]);function removeDangerousAttributes(element){const attributes=element.attributes;for(let i=attributes.length-1;i>=0;i--){const attr=attributes[i];if(/^on\w+/i.test(attr.name)||/^javascript:/i.test(attr.value))element.removeAttribute(attr.name);}const children=element.children;for(let i=0;i<children.length;i++)removeDangerousAttributes(children[i]);}removeDangerousAttributes(unsafeHtml);}else{if(typeof unsafeHtml==='string'){unsafeHtml=unsafeHtml.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi,'');unsafeHtml=unsafeHtml.replace(/ on\w+="[^"]*"/g,'');unsafeHtml=unsafeHtml.replace(/ on\w+='[^']*'/g,'');unsafeHtml=unsafeHtml.replace(/ javascript:[^"']*/g,'');}}return unsafeHtml;}function cumminsSanitizeAttribute(attr){return attr.replace(/[^a-zA-Z0-9-_#&+. ]/g,'');}var trustedDomains=["cummins.com","t3.cummins.com"];function cumminsSanitizeUrl(url){try{var parsedUrl=new URL(url);return trustedDomains.some(function(domain){if(parsedUrl.hostname.endsWith(domain))return url;else return 'cummins.com';});}catch(e){return 'cummins.com';}};
