ction(){var $value=$field.val();var $id=$field.attr('id');var $label=$('label[for="'+$id+'"]');if($value.length>0)$label.show();else $label.hide();});$field.trigger('change');});$textareas.each(function(){var $field=$(this);$field.on('change',function(){var $value=$field.val();var $id=$field.attr('id');var $label=$('label[for="'+$id+'"]');if($value.length>0)$label.show();else $label.hide();});$field.trigger('change');});$selects.each(function(){var $field=$(this);$field.on('change',function(){var $id=$field.attr('id');var $label=$('label[for="'+$id+'"]');if($field.val()!='_none')$label.show();else $label.hide();});$field.trigger('change');});}}};Drupal.behaviors.loadMoreAccordion={attach:function(context,settings){$('.load-more',context).on('click',function(){$('.'+this.attributes['load-more-id'].value).show();$(this).hide();});}};Drupal.behaviors.estContactForm={attach:function(context,settings){$('#edit-i-need-help-with-',context).on('change',function(){if(this.value=='Finding a Cummins Certified Service Provider or Parts Support'){var win=window.open('https://locator.cummins.com','_blank');if(win)win.focus();}});}};Drupal.behaviors.estHelpTimeout={attach:function(context,settings){var $chatButton=$('.live-chat__button');if($chatButton.length)if(settings.cummins_est&&settings.cummins_est.channel_has_technician&&settings.cummins_est.channel_has_technician.match(/TRUE/g)&&!window.location.href.match(/chat_offline/g))$chatButton.addClass('show');else $.each($('.is-chat'),function(index,el){$(el).removeClass('online').addClass('offline');});}};Drupal.behaviors.estContactNumbers={attach:function(context,settings){var $selected=$('.est-contact-phone-selected');$.each($('.contact-cummins-care__by-phone .views-row'),function(index,el){var text=$(el).text();var colonIndex=text.indexOf(':');if(colonIndex>12&&text.indexOf('Nether')===-1)text=text.replace(':',':<br/>');else{if(text.indexOf('(')!==-1&&text.indexOf('(0)')===-1)text=text.replace('(','<br/>(');}$(el).html(text);}