10);}$(document).ready(function(){checkForInit();});});}};Drupal.behaviors.prodTabNavigation={attach:function(context,settings){var element=$(once("prodTabNavigation",$(context).find('.tab_navigation__navigation'),context));element.each(function(){$('.tab_navigation__navigation__button').each(function(){if(this.id){var _tabs=$('.tab_navigation__tab');var _buttons=$('.tab_navigation__navigation__button');var _id=this.id;$(this).on('click',function(){_buttons.each(function(){$(this).removeClass('active');});_tabs.each(function(){$(this).removeClass('active');});$(this).addClass('active');$('[data-tab="'+_id+'"]').addClass('active');});}});if($('#ratings-tab').length)setTimeout(function(){$('#ratings-tab').trigger('click');},0);});}};function cumminsWindowResize(){if(window.innerWidth<=768){$('body').addClass('mobile-view');$('body').removeClass('desktop-view');}else{$('body').removeClass('mobile-view');$('body').addClass('desktop-view');}}Drupal.behaviors.searchFormInput={attach:function(context,settings){var element=$(once("searchFormInput",$(context).find('#block-exposedformsearchpage-1'),context));element.each(function(){$(this).find('#edit-search-api-fulltext').val('');});}};Drupal.behaviors.contactCumminsCare={attach:function(context,settings){var element=$(once("#block-electronicservicesupportrequests",$(context).find('#block-electronicservicesupportrequests'),context));element.each(function(){if(window.location.href.indexOf('/customer-assistance')>=0){var html='<p>For sales information or to request a quote, please use our ';html+='<a href=/sales-and-service#rfq-title>Sales and Service Request form</a>.</p>';var $p=$(html);$('.contact-cummins-care__by-phone').append($p);}});}};Drupal.behaviors.overlayRemove={attach:function(context,settings){$('.js-overlay').on('click',function(e){e.preventDefault();ytplayer.playVideo();$(this).addClass('overlay-hidden');});}};Drupal.behaviors.embedYoutubePlaylist={attach:function(context,settings){var element=$(once("embedYoutubePlaylist",$(context).find('.yt-embed-playlist[data-id]'),context));element.each(function(){var $videoElement=$(this);var videoElementID=$videoElement.attr('id');var youtubeID=$videoElement.attr('data-id');var player;var tag=document.createElement('script');tag.src='https://www.youtube.com/iframe_api';var firstScriptTag=document.getElementsByTagName('script')[0];firstScriptTag.parentNode.insertBefore(tag,firstScriptTag);window.onYouTubeIframeAPIReady=function(){player=new YT.Player(videoElementID,{height:'320',width:'320',playerVars:{autoplay:0,rel:0},events:{onReady:loadPlaylist}});window.ytplayer=player;};window.loadPlaylist=function(){if(youtubeID.substr(0,2)=='PL')player.cuePlaylist({list:youtubeID,listType:'playlist',index:0,startSeconds:0});else player.cueVideoById({videoId:youtubeID});};});}};Drupal.behaviors.caseStudyLibrary={attach:function(context,settings){var element=$(once(".page-node-type-case-study-overview",$(context).find('.page-node-type-case-study-overview'),context));element.each(function(){$('#edit-field-market-target-id').on('change',function(){$('#edit-field-market-target-id').closest('form').submit();});$('.case-study').on('click',function(){var href=$(this).find('a').attr('href');window.location=href;});});if(window.location.href.indexOf('?field_market')!==-1){var $block=$('#block-views-block-case-studies-library-block-1');setTimeout(function(){$(window).scrollTop($block.offset().top-200);},1000);}}};Drupal.behaviors.multiproductView={attach:function(context,settings){var element=$(once("multiproductView",$(context).find('button.js-view-dropdown-link'),context));element.each(function(){var selectedItem=$(this).siblings('select');selectedItem=$(':selected',selectedItem).val();$(this).click(function(){window.location.href=selectedItem;});});}};Drupal.behaviors.regionSelectWebform={attach:function(context,settings){var element=$(once("regionSelectWebform",$(context).find('#location-select-form'),context));element.each(function(){var currentRe