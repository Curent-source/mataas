('.slick-initialized'),function(i,el){var height=$(el).height();if(height===0)$(el).remove();else $(el).slick('slickSetOption',{infinite:false},true);});},1000);});}};Drupal.behaviors.cumminsSidebarContactNumbers={attach:function(context,settings){var element=$(once("cumminsSidebarContactNumbers",$(context).find('.sidebar-cta-item-contact-method'),context));element.each(function(){formatCumminsCareContactNumbers();cumminsCareContactNumberSelect();});}};Drupal.behaviors.cumminsHeroContactNumbers={attach:function(context,settings){var element=$(once("cumminsHeroContactNumbers",$(context).find('.hero-feature__contact'),context));element.each(function(){formatCumminsCareContactNumbers();cumminsCareContactNumberSelect();});}};function formatCumminsCareContactNumbers(){jQuery('.est-contact-phone-list [phone-number]').each(function(){var phoneNumber=jQuery(this).text();var phoneNumberFormatted;var hasCummins=phoneNumber.match(/(CUMMINS[^\s]?)/);if(hasCummins)phoneNumberFormatted=phoneNumber.replace(/(CUMMINS[^\s]?)/,'$1<br>');else phoneNumberFormatted=phoneNumber.replace(/:/,':<br>');jQuery(this).html(phoneNumberFormatted);});}Drupal.behaviors.cumminsCare={attach:function(context,settings){var examplePlaceholders=['Search our support library here.'];var index=getRandomInt(0,examplePlaceholders.length-1);var element=$(once("cumminsCare",$(context).find('.care-footer'),context));element.each(function(){cumminsCareContactNumberSelect();$('.button--red-x-close').attr('data-dismiss','modal');var dow=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];var monthNames=['January','February','March','April','May','June','July','August','September','October','November','December'];var date=new Date();var text=dow[date.getDay()]+', '+monthNames[date.getMonth()]+' '+date.getDate()+', '+date.getFullYear();$('#customer-assistance-current-date').text(text);if(settings.cummins_est&&settings.cummins_est.channel_has_technician&&settings.cummins_est.channel_has_technician.match(/TRUE/g)&&!window.location.href.match(/chat_offline/g))$('.is-chat').on('click',function(){$('.live-chat__button').trigger('click');});$('.est-contact-phone-selected').show();$('.est-contact-phone-list').show();var title=jQuery(jQuery('.field--name-title')[0]).text();if(!title.trim().length)title=jQuery(jQuery('.c-hero .c-hero__title')[0]).text();jQuery('.cummins-okm-search-form div.eyebrow').text('Search '+title+' Topics');jQuery('.cummins-okm-search-form [data-drupal-selector="edit-search"]').attr('placeholder',examplePlaceholders[index]);});if($('.cummins-okm-search-form').length){var placeholder=$('#care-hero-placeholder').data('placeholder');if(typeof placeholder==='undefined')placeholder=examplePlaceholders[index];$('.cummins-okm-search-form input[data-drupal-selector="edit-search"]').attr('placeholder',placeholder);if($('.care-footer-contact-method.is-phone').length){var $el=$('.care-footer-contact-method.is-phone');var selected=$el.find('.est-contact-phone-selected .views-row').text();selected=selected.split(':')[0];$el.find('div strong').text(selected);$el.find('.est-contact-phone-list div').on('click',function(){var selected=$el.find('.est-contact-phone-selected .views-row').text();selected=selected.split(':')[0];$el.find('div strong').text(selected);});}}}};function cumminsCareContactNumberSelect(){var countryCode=getCookie('acquia_a');var isoCountries={AF:'Afghanistan',AX:'Aland Islands',AL:'Albania',DZ:'Algeria',AS:'American Samoa',AD:'Andorra',AO:'Angola',AI:'Anguilla',AQ:'Antarctica',AG:'Antigua And Barbuda',AR:'Argentina',AM:'Armenia',AW:'Aruba',AU:'Australia',AT:'Austria',AZ:'Azerbaijan',BS:'Bahamas',BH:'Bahrain',BD:'Bangladesh',BB:'Barbados',BY:'Belarus',BE:'Belgium',BZ:'Belize',BJ:'Benin',BM:'Bermuda',BT:'Bhutan',BO:'Bolivia',BA:'Bosnia And Herzegovina',BW:'Botswana',BV:'Bouvet Island',BR:'Brazil',IO:'British Indian Ocean Territory',BN:'Brunei Darussalam',BG:'Bulgaria',BF:'Burkina Faso',BI:'Burundi',KH:'Cambodia',CM:'Cameroon',CA:'Canada',C