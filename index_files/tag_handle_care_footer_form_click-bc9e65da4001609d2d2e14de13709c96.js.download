let formTrigger = document.getElementById('open-customer-care-form')
if (formTrigger) {
	formTrigger.innerHTML = '<strong>Contact Us</strong>'
	formTrigger.removeAttribute('data-target')
	formTrigger.removeAttribute('data-toggle')
	formTrigger.addEventListener('click', function (e) {
	  e.preventDefault()
	  window.location.href = '/customer-assistance'
	})	
}
